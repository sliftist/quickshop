{
    "name": "quick-shop",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "dependencies": {
        "sliftutils": "^1.9.9",
        "socket-function": "*"
    },
    "scripts": {
        "type": "yarn tsc --noEmit",
        "build-extension": "build-extension && typenode ./bin/buildPageScript.ts",
        "build-extension-prod": "typenode ./bin/buildProduction.ts",
        "watch-extension": "typenode ./bin/watch.ts --port 9878 \"yarn build-extension\" --delayed-command \"yarn build-extension-prod\"",
        "reload-extension": "typenode ./bin/trigger.ts --port 9878"
    },
    "resolutions": {
        "preact": "npm:preact-old-types@*"
    }
}
